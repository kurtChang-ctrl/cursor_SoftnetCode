<script type="text/javascript">
    $(function () {
        IS_SYS_Clock = false;
        if (SYS_ClickBlock) { _fun.unBlock(); }
        SYS_ClickBlock = false;

        $('#btnBppSearch').closest('form').on('submit', function () {
            _fun.block();
            SYS_ClickBlock = true;
        });
    });
    var _me = {
        hasStaionStatus: false,
        hasSimulatioStatus: false,
        STView2Work_PageReload: false,
        hasStaionChangQTY: false,
    };
</script>

<style>
    .bpp-filter-container {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #e0e4e8;
        border-radius: 8px;
        padding: 10px 16px;
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .bpp-filter-container label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #374151;
        white-space: nowrap;
    }

    .bpp-filter-container input[type="text"] {
        border: 1px solid #d1d5db;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 0.85rem;
        width: 130px;
        transition: border-color 0.2s;
    }

    .bpp-filter-container input[type="text"]:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 2px rgba(59,130,246,0.15);
    }

    .bpp-filter-container select {
        border: 1px solid #d1d5db;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 0.85rem;
        background: #fff;
    }

    .bpp-filter-container select:focus {
        outline: none;
        border-color: #3b82f6;
    }

    .bpp-btn-search {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: #fff;
        border: none;
        border-radius: 5px;
        padding: 6px 18px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }

    .bpp-btn-search:hover {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        transform: translateY(-1px);
    }

    .bpp-btn-search:active {
        transform: translateY(0);
    }


    /* 優化表格顯示效能和樣式 */
    .xp-prog table {
        border-collapse: collapse;
        width: 100%;
        table-layout: auto;
        margin-bottom: 10px;
    }

    .xp-prog table td,
    .xp-prog table th {
        padding: 4px 6px;
        text-align: left;
        border: 1px solid #ddd;
        word-wrap: break-word;
        vertical-align: top;
        line-height: 1.3;
    }

    .xp-prog table tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    .xp-prog table tr:hover {
        background-color: #f5f5f5;
    }
</style>

<form method="get" asp-action="BOMProductProcess" asp-controller="Display">
    <input type="hidden" name="isQuery" value="1" />
    <div class="bpp-filter-container">
        <label>料號:</label>
        <input type="text" name="filterPartNO" value="@ViewBag.FilterPartNO" placeholder="輸入料號" />
        <label>品名:</label>
        <input type="text" name="filterPartName" value="@ViewBag.FilterPartName" placeholder="輸入品名" />
        <label>規格:</label>
        <input type="text" name="filterSpec" value="@ViewBag.FilterSpec" placeholder="輸入規格" />
        <label>類型:</label>
        @{
            string curClass = ViewBag.FilterClass ?? "45";
        }
        <select name="filterClass">
            <!option value="45" selected="@(curClass == "45" || curClass == "")">全部生產件</!option>
            <!option value="4" selected="@(curClass == "4")">半成品</!option>
            <!option value="5" selected="@(curClass == "5")">成品</!option>
        </select>
        <button type="submit" class="bpp-btn-search" id="btnBppSearch">確認查詢</button>
    </div>
</form>

<div class="xp-prog">
    @Html.Raw(ViewBag.HtmlOutput)
</div>

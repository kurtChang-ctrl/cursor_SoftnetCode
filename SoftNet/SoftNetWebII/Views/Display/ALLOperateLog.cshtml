@model APSViewData
@{
    var operateTypes = new string[]
    {
        "干涉修正", "自動報工", "新增項目", "智慧開工", "設定工單", "智慧報工",
        "干涉修正報工量", "設定人員", "設定工站", "干涉停工", "智慧關站 系統主動干涉",
        "網頁報工", "智慧領料", "智慧入料", "智慧關站", "智慧停工"
    };
    bool IsAllSelected(string selected) => selected == "ALL" || string.IsNullOrEmpty(selected);
    bool IsItemSelected(string selected, string value) => !IsAllSelected(selected) && (";" + selected + ";").Contains(";" + value + ";");
    string chkStationAll = IsAllSelected(Model.SelectFun3) ? "checked" : "";
    string chkUserAll = IsAllSelected(Model.SelectFun4) ? "checked" : "";
    string chkOperateAll = IsAllSelected(Model.SelectFun5) ? "checked" : "";
}

<script type="text/javascript">
    $(function () {
        IS_SYS_Clock = false;
        if (SYS_ClickBlock) { _fun.unBlock(); }
        SYS_ClickBlock = false;

        function bindAllToggle(allId, itemName) {
            $('#' + allId).on('change', function () {
                if (this.checked) {
                    $('input[name="' + itemName + '"]').prop('checked', false);
                }
            });
            $('input[name="' + itemName + '"]').on('change', function () {
                if (this.checked) {
                    $('#' + allId).prop('checked', false);
                }
            });
        }
        bindAllToggle('chkStationAll', 'dataStation');
        bindAllToggle('chkUserAll', 'dataUser');
        bindAllToggle('chkOperateAll', 'dataOperate');
    });

    var _me = {
        hasStaionStatus: false,
        hasSimulatioStatus: false,
        STView2Work_PageReload: false,
        hasStaionChangQTY: false,
        collectChecked: function (allId, itemName, hiddenName) {
            if (document.getElementById(allId).checked) {
                $("input[name=" + hiddenName + "]").val('ALL');
                return;
            }
            var tmp = '';
            var items = document.getElementsByName(itemName);
            for (var i = 0; i < items.length; i++) {
                if (items[i].checked) {
                    tmp = tmp + items[i].value + ';';
                }
            }
            $("input[name=" + hiddenName + "]").val(tmp);
        },
        onSet: function () {
            _me.collectChecked('chkStationAll', 'dataStation', 'SelectFun3');
            _me.collectChecked('chkUserAll', 'dataUser', 'SelectFun4');
            _me.collectChecked('chkOperateAll', 'dataOperate', 'SelectFun5');
        },
    };
</script>

<div id="selectStationPage" class="xp-prog">
    <form action=@Url.Action("ALLOperateLog") method="post">
        <input type="hidden" name="SelectFun3" value="@Model.SelectFun3" />
        <input type="hidden" name="SelectFun4" value="@Model.SelectFun4" />
        <input type="hidden" name="SelectFun5" value="@Model.SelectFun5" />
        <input type="hidden" name="SelectFun6" value="@Model.SelectFun6" />
        <div class="pc-form-container">
            <div class="pc-form-body">
                <div class="pc-form-row">
                    <span class="pc-label">查詢日期:</span>
                    <input type="date" class="pc-input" name="SelectFun1" value="@Model.SelectFun1" min="2023-01-01" max="2035-12-31" />
                    <span>~</span>
                    <input type="date" class="pc-input" name="SelectFun2" value="@Model.SelectFun2" min="2023-01-01" max="@Model.SelectFun6" />
                </div>
                <div class="pc-form-row">
                    <span class="pc-label">查詢 計畫編號:</span>
                    <input type="text" class="pc-input" style="width:280px;" name="MBOMId" value="@Model.MBOMId" placeholder="留空表示不限計畫" />
                </div>
                <div class="pc-form-row">
                    <span class="pc-label">工單編號:</span>
                    <input type="text" class="pc-input" style="width:280px;" name="SelectNeedId" value="@Model.SelectNeedId" placeholder="留空表示不限工單" />
                </div>
                <div class="pc-form-row pc-checkbox-row">
                    <span class="pc-label">選擇工站:</span>
                    <label class="pc-check"><input type="checkbox" id="chkStationAll" value="ALL" @chkStationAll />全部</label>
                    @if (Model.StationList != null)
                    {
                        @foreach (string[] s in Model.StationList)
                        {
                            <label class="pc-check"><input type="checkbox" name="dataStation" value="@s[0]" @(IsItemSelected(Model.SelectFun3, s[0]) ? "checked" : "") />@s[0] @s[1]</label>
                        }
                    }
                </div>
                <div class="pc-form-row pc-checkbox-row">
                    <span class="pc-label">操作人員:</span>
                    <label class="pc-check"><input type="checkbox" id="chkUserAll" value="ALL" @chkUserAll />全部</label>
                    @if (Model.UserList != null)
                    {
                        @foreach (string[] u in Model.UserList)
                        {
                            <label class="pc-check"><input type="checkbox" name="dataUser" value="@u[0]" @(IsItemSelected(Model.SelectFun4, u[0]) ? "checked" : "") />@u[0] @u[1]</label>
                        }
                    }
                </div>
                <div class="pc-form-row pc-checkbox-row">
                    <span class="pc-label">選擇操作:</span>
                    <label class="pc-check"><input type="checkbox" id="chkOperateAll" value="ALL" @chkOperateAll />全部</label>
                    @foreach (string op in operateTypes)
                    {
                        <label class="pc-check"><input type="checkbox" name="dataOperate" value="@op" @(IsItemSelected(Model.SelectFun5, op) ? "checked" : "") />@op</label>
                    }
                </div>
            </div>
            <div class="pc-form-action">
                <button type="submit" class="pc-btn pc-btn-submit" onclick="this.style.display='none';_me.onSet();">確認查詢</button>
            </div>
        </div>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.ERRMsg))
{
    <div class="xp-prog">
        <p><font color="red" size="5">錯誤訊息:<strong>@Model.ERRMsg</strong></font></p>
    </div>
}

<style>
    .pc-form-container {
        display: flex;
        align-items: stretch;
        gap: 10px;
        border: 1px solid #e0e4e8;
        border-radius: 8px;
        padding: 10px 16px;
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        margin-bottom: 12px;
    }

    .pc-form-body {
        flex: 1;
    }

    .pc-form-action {
        display: flex;
        align-items: center;
        padding-left: 10px;
        border-left: 1px solid #e0e4e8;
        flex: 0 0 auto;
    }

    .pc-form-row {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 0;
        flex-wrap: wrap;
    }

    .pc-checkbox-row {
        align-items: flex-start;
        padding-top: 4px;
        padding-bottom: 4px;
    }

    .pc-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: #374151;
        white-space: nowrap;
        min-width: 95px;
    }

    .pc-input {
        border: 1px solid #d1d5db;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 0.88rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }

    .pc-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
    }

    .pc-check {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 0.85rem;
        color: #4b5563;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 4px;
        transition: background 0.15s;
    }

    .pc-check:hover {
        background: #eff6ff;
    }

    .pc-check input[type="checkbox"] {
        accent-color: #3b82f6;
    }

    .pc-btn {
        border: none;
        border-radius: 6px;
        padding: 8px 18px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }

    .pc-btn-submit {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: #fff;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
    }

    .pc-btn-submit:hover {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    }

    .xp-prog table {
        border-collapse: collapse;
        width: 100%;
        table-layout: auto;
    }

    .xp-prog table td,
    .xp-prog table th {
        padding: 4px 6px;
        text-align: left;
        border: 1px solid #ddd;
        word-wrap: break-word;
        vertical-align: top;
        line-height: 1.3;
    }

    .xp-prog table tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    .xp-prog table tr:hover {
        background-color: #f5f5f5;
    }

    .xp-prog table tr:first-child {
        background-color: #4CAF50;
        color: white;
        font-weight: bold;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .xp-prog table td {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@if (ViewBag.HtmlOutput != null && ViewBag.HtmlOutput != "")
{
    <div class="xp-prog">
        @Html.Raw(ViewBag.HtmlOutput)
    </div>
}

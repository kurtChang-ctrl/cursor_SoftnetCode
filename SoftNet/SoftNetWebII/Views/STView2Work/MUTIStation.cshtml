<!--所有項目表-->
<div id="displayHasWorkData_List" class="ms-card ms-card-work">
    <form method="post">
        <input type='hidden' name='Station_Config_Store_Type' value="@DATAObj.Station_Config_Store_Type" />
        <input type='hidden' name='OrderBY_CMD' value="@DATAObj.OrderBY_CMD" />
        <input type='hidden' name='Has_Knives' value="@DATAObj.Has_Knives" />
        <input type='hidden' name='StationNO' value="@DATAObj.StationNO" />
        <input type='hidden' id="Select_ID" name='Select_ID' value="@DATAObj.Select_ID" />

        @{
            if (DATAObj.HasWorkData_List == null)
            {
                <h2>已有項目筆數: 0</h2>
            }
            else
            {
                <h2>已有項目筆數: @DATAObj.HasWorkData_List.Count</h2>
            }
        }
        <button id="bn_PageReload" type="submit" onclick='this.style.display="none";this.form.action="@Url.Action("MUTIStation", "STView2Work")" '>資料須更新<br />請按我一下</button>
        
        @{
            if (DATAObj.HasWorkData_List != null)
            {
                <label id="showdata"></label>
                <table class="table table-bordered xg-table ms-main-table" id="DisplayDataTable">
                    <thead>
                        <tr>
                            <th>選擇</th>
                            <th class="sortable-th" onclick="_me.st2SortTable('DisplayDataTable',1)">狀態</th>
                            <th class="sortable-th" onclick="_me.st2SortTable('DisplayDataTable',2)">料件編號</th>
                            <th class="sortable-th" onclick="_me.st2SortTable('DisplayDataTable',3)">品名/規格</th>
                            <th class="sortable-th" onclick="_me.st2SortTable('DisplayDataTable',4)">工序</th>
                            <th class="sortable-th" onclick="_me.st2SortTable('DisplayDataTable',5)">工單編號</th>
                            <th>需求量</th>
                            <th>累計OK量</th>
                            <th>Fail量</th>
                            <th>前站報工</th>
                            <th>實際CT</th>
                            <th>目標CT</th>
                            <th>開始時間</th>
                            <th>停止時間</th>
                            <th>製程</th>
                        </tr>
                    </thead>
                    <tbody id="DisManufacture">
                         @{
                            var fontClass = "stateNOT";
                            for (int i = 0; i < DATAObj.HasWorkData_List.Count; i++)
                            {
                                string[] data = DATAObj.HasWorkData_List[i];
                                                                                                <tr>
                                                                                                    <td><input type="checkbox" name="optradio" value="@data[0]"></td>
                                                                                                    @{
                                        fontClass = "stateNOT";
                                        if (data[1] == "生產") { fontClass = "stateGreen"; }
                                        else if (data[1] == "停止") { fontClass = "stateRed"; }
                                                                                                    }
                                                                                                    <td class="@fontClass">@data[1]</td>
                                                                                                    <td>@data[2]</td>
                                                                                                    <td>@data[3]&nbsp;@data[4]</td>
                                                                                                    <td>@data[6]</td>
                                                                                                    <td>@data[7]</td>
                                                                                                    <td>@data[14]</td>
                                                                                                    <td>@data[8]</td>
                                                                                                    <td>@data[9]</td>
                                                                                                    <td>@data[17]</td>
                                                                                                    <td>@data[10]</td>
                                                                                                    <td>@data[11]</td>
                                                                                                    <td>@data[12]</td>
                                                                                                    <td>@data[13]</td>
                                                                                                    <td>@data[5]</td>

                                                                                                </tr>
                                                                        
                            }
                                                        }
                                                    </tbody>
                                                </table>
                for (int i = 0; i < DATAObj.HasWorkData_List.Count; i++)
                {
                    string[] data = DATAObj.HasWorkData_List[i];
                            <input type='hidden' id='@data[0]' value="@data[18]" />
                }
            }
        }
    </form>
</div>

<!--報工-->
<div id="stationSetINFO" class="ms-card ms-card-report">
    <h2>報工作業</h2>
    <form action=@Url.Action("SetAction") method="post">
        <input type='hidden' name='Station_Config_Store_Type' value="@DATAObj.Station_Config_Store_Type" />
        <input type='hidden' name='OrderBY_CMD' value="@DATAObj.OrderBY_CMD" />
        <input type='hidden' name='Has_Knives' value="@DATAObj.Has_Knives" />
        <input type='hidden' name='State' value="報工" />
        <input type='hidden' name='StationNO' value="@DATAObj.StationNO" />
        <input type='hidden' name='StationName' value="@DATAObj.StationName" />
        <input type='hidden' name='SI_OrderNO' value="@DATAObj.SI_OrderNO" />
        <input type='hidden' name='SI_SimulationId' value="@DATAObj.SI_SimulationId" />
        <input type='hidden' name='SI_Slect_OPNOs' value="" />
        <input type='hidden' id="Select_ID" name='Select_ID' value="@DATAObj.Select_ID" />
        <div class="ms-report-field"><label>選擇報工員工:</label></div>
        <div class="ms-staff-grid">
            @{
                if (DATAObj.HasPO_List != null && DATAObj.HasPO_List.Count > 0)
                {

                                                    @foreach (string[] s in DATAObj.HasPO_List)
                    {
                        var s_tmp = s[0];
                        var s_tmp2 = s[1];
                                                        <input class="input_arg" type="checkbox" id="SI_OPNO" name="SI_OPNO" value='@s_tmp'>
                                                        <label>@s_tmp2</label>
                    }

                }
            }
        </div>
        <div class="ms-report-field"><label>本次生產量:</label><input type='number' name='SI_OKQTY' placeholder="輸入本次報工良品數" /></div>
        <div class="ms-report-field"><label>本次不良量:</label><input type='number' name='SI_FailQTY' placeholder="本次不良品數" /></div>
        <div class="ms-report-field"><label>備註說明:</label><input type='text' name='Remark' /></div>
        <div class="ms-actions">
            <button type='submit' class="ms-btn ms-btn-primary" onclick="this.style.display='none'; _me.qqww()">&#10004; 報工確定</button>
        </div>
    </form>
</div>

<!--新增項目-->
<div id="displayNULL" class="ms-card ms-card-add">
    <h2>新增項目</h2>
    <form action=@Url.Action("SetAction") method="post">
        <input type='hidden' name='Station_Config_Store_Type' value="@DATAObj.Station_Config_Store_Type" />
        <input type='hidden' name='OrderBY_CMD' value="@DATAObj.OrderBY_CMD" />
        <input type='hidden' name='Has_Knives' value="@DATAObj.Has_Knives" />
        <input type='hidden' name='SI_SimulationId' value="@DATAObj.SI_SimulationId" />
        <input type='hidden' name='SI_OrderNO' value="@DATAObj.SI_OrderNO" />
        <input type='hidden' name='SI_IndexSN' value="@DATAObj.SI_IndexSN" />
        @{
            int st2WoA = DATAObj.HasWO_List != null ? DATAObj.HasWO_List.Count : 0;
            int st2WoP = DATAObj.HasWO_List_Paused != null ? DATAObj.HasWO_List_Paused.Count : 0;
            if (st2WoA > 0 || st2WoP > 0)
            {
                <p class="lw-st2-wo-title">選擇工單</p>
                <div class="lw-st2-wo-tabs" role="tablist">
                    <button type="button" id="st2-wo-tab-active" class="lw-st2-wo-tab lw-st2-wo-tab-active @(st2WoA > 0 ? "lw-st2-tab--active" : "")" role="tab" aria-selected="@(st2WoA > 0 ? "true" : "false")" onclick="_me.st2woListTab('active'); return false;">
                        在線可用工單<span class="lw-st2-wo-badge">@st2WoA</span>
                    </button>
                    <button type="button" id="st2-wo-tab-paused" class="lw-st2-wo-tab lw-st2-wo-tab-paused @(st2WoA == 0 && st2WoP > 0 ? "lw-st2-tab--active" : "")" role="tab" aria-selected="@(st2WoA == 0 && st2WoP > 0 ? "true" : "false")" onclick="_me.st2woListTab('paused'); return false;">
                        離線暫停工單<span class="lw-st2-wo-badge">@st2WoP</span>
                    </button>
                </div>
                <div id="st2-wo-panel-active" class="lw-st2-wo-panel lw-st2-wo-panel-active" style="display:@(st2WoA > 0 ? "block" : "none")" role="tabpanel">
                    @if (st2WoA > 0)
                    {
                        <div class="lw-st2-wo-table-wrap">
                            <table id="tableReadActive" class='table table-bordered xg-table ms-main-table' cellspacing='0'>
                                <thead><tr><th>選擇</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadActive',1)">工單編號</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadActive',2)">料號</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadActive',3)">品名</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadActive',4)">規格</th><th>需求量</th><th>需求型態</th><th>需求名稱</th><th>製程名稱</th><th>順序</th><th>工序</th><th>工序名稱</th></tr></thead>
                                <tbody>
                                    @foreach (string[] s in DATAObj.HasWO_List)
                                    {
                                        <tr>
                                            <td>
                                                <input type="radio" name="woList" onchange="_me.radioChange('@s[0];@s[7];@s[8]')" />
                                            </td>
                                            <td>@s[0]</td>
                                            <td>@s[1]</td>
                                            <td>@s[2]</td>
                                            <td>@s[3]</td>
                                            <td>@s[11]</td>
                                            <td>@s[4]</td>
                                            <td>@s[5]</td>
                                            <td>@s[6]</td>
                                            <td>@s[7]</td>
                                            <td>@s[9]</td>
                                            <td>@s[10]</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <span class="lw-st2-wo-empty">此分頁無可用工單（進行中需求且工單未暫停）。</span>
                    }
                </div>
                <div id="st2-wo-panel-paused" class="lw-st2-wo-panel lw-st2-wo-panel-paused" style="display:@(st2WoA > 0 ? "none" : "block")" role="tabpanel">
                    @if (st2WoP > 0)
                    {
                        <div class="lw-st2-wo-table-wrap">
                            <table id="tableReadPaused" class='table table-bordered xg-table ms-main-table' cellspacing='0'>
                                <thead><tr><th>選擇</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadPaused',1)">工單編號</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadPaused',2)">料號</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadPaused',3)">品名</th><th class="sortable-th" onclick="_me.st2SortTable('tableReadPaused',4)">規格</th><th>需求量</th><th>需求型態</th><th>需求名稱</th><th>製程名稱</th><th>順序</th><th>工序</th><th>工序名稱</th></tr></thead>
                                <tbody>
                                    @foreach (string[] s in DATAObj.HasWO_List_Paused)
                                    {
                                        <tr>
                                            <td>
                                                <input type="radio" name="woList" onchange="_me.radioChange('@s[0];@s[7];@s[8]')" />
                                            </td>
                                            <td>@s[0]</td>
                                            <td>@s[1]</td>
                                            <td>@s[2]</td>
                                            <td>@s[3]</td>
                                            <td>@s[11]</td>
                                            <td>@s[4]</td>
                                            <td>@s[5]</td>
                                            <td>@s[6]</td>
                                            <td>@s[7]</td>
                                            <td>@s[9]</td>
                                            <td>@s[10]</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <span class="lw-st2-wo-empty">此分頁無暫停需求工單。</span>
                    }
                </div>
            }
            else
            {
                <span class="lw-st2-wo-empty">目前本站無其他生產計劃需求工單。</span>
                <p style="margin-top:.5rem;"><button type="submit" class="ms-btn ms-btn-outline" onclick='this.style.display="none";this.form.action="@Url.Action("MUTIStation", "STView2Work")" '>查詢看看有沒有新的工單</button></p>
            }
        }

        <input type='hidden' id='LocalIPPort' name='LocalIPPort' />
        <input type='hidden' name='State' value="新增項目" />
        <input type='hidden' name='StationNO' value="@DATAObj.StationNO" />
        <input type='hidden' name='StationName' value="@DATAObj.StationName" />
        <div class="ms-actions">
            <button type='submit' class="ms-btn ms-btn-warning" onclick="this.style.display='none'">&#10004; 新增項目 確認</button>
        </div>
    </form>
</div>




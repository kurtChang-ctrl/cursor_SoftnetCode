@using Base
@model MUTIStationObj
@{
    MUTIStationObj DATAObj = (MUTIStationObj)ViewBag.DATA;
    string err = DATAObj.ERRMsg;
    string disUserName = "畫面逾時";
    string thisStationNO = DATAObj.StationNO;
    if (_Fun.GetBaseUser() != null) { disUserName = _Fun.GetBaseUser().UserName; }
}

<script type="text/javascript">
    $(document).ready(function () {
        IS_SYS_Clock = false;
        if (SYS_ClickBlock) { _fun.unBlock(); }
        SYS_ClickBlock = false;
        $("title").text("@Html.Raw(disUserName)");
        _leftmenu.onToggleMenu();

        $('input[type=checkbox][name=optradio]').change(function () {
            if ($(this).is(':checked')) {
                var tmp = $("#Select_ID_Action").val() + this.value + ";";
                $("input[name=Select_ID]").val(tmp);
            }
            else {
                var tmp = $("#Select_ID_Action").val();
                var tmp02 = this.value + ";";
                $("input[name=Select_ID]").val(tmp.replace(tmp02, ""));
            }
        });
        jQuery('[data-confirm]').click(function (e) {
            if (!confirm(jQuery(this).attr("data-confirm"))) {
                e.preventDefault();
            }
        });
        $('#woClosebutton').click(function (e) {
            var tmp = $("#Select_ID_Action").val();
            var ckINFO = '你確定執行 將工單結束 作業?\n\r';
            if (tmp != '') {
                $.each(tmp.split(';'), function (id, data) {
                    if (data != '') {
                        var ckValue = $("#" + data).val();
                        if (ckValue != '') {
                            ckINFO = ckINFO + '\n\r' + ckValue;
                        }
                    }
                });
            }
            var result = window.confirm(ckINFO);
            if (result == false) {
                e.preventDefault();
            }
            else {
                this.form.action = "@Url.Action("SetStation_Close", "STView2Work")";
            }
        });
    });
    var meStationNO = '@Html.Raw(thisStationNO)';
    var _me = {
        hasStaionStatus: false,
        hasStaionChangQTY: false,
        hasSimulatioStatus: false,
        STView2Work_PageReload: true,

        onSTView2Work_PageReload: function (staionNO) {
            if (staionNO == meStationNO) {
                var conObj = document.getElementById('bn_PageReload');
                if (conObj.style.display == '') { conObj.style.display = 'inline'; }
            }
        },
        sortCMD: function (id) {
            //目前沒用到,下code 為Mobile 呼叫 ajax, 而非 _ajax.getStr
            var str = meStationNO + ',' + id + ',' + _me.is_Sort_Desc;
            $.ajax({
                url: 'SET_Sort_CMD',
                type: 'POST',
                dataType: 'text',
                data: { key: str },
                success: function (res) {
                    if (!_str.isEmpty(res)) {
                        //$("#DisManufacture").empty();
                        //alert(res);
                        //$('#DisManufacture').html(data);
                        // if (_me.is_Sort_Desc == '1') { _me.is_Sort_Desc = '0'; }
                        // else { _me.is_Sort_Desc = '1'; }
                    }
                },
                error: function (err) { console.log(err) },
            });
        },
        clickFunction: function (status) {
            switch (status) {
                case 0://回主頁
                    //$('#stationSetINFO').hide();
                    //$('#displayNULL').show();
                    break;
                case 3://報工
                    //$('#displayNULL').hide();
                    //$('#stationSetINFO').show();
                    break;
            }
        },
        radioChange: function (data) {
            var tmp = data.split(';');
            $("input[name=SI_OrderNO]").val(tmp[0]);
            $("input[name=SI_IndexSN]").val(tmp[1]);
            $("input[name=SI_SimulationId]").val(tmp[2]);
        },
        st2woListTab: function (which) {
            var showA = which === 'active';
            $('#st2-wo-panel-active').toggle(showA);
            $('#st2-wo-panel-paused').toggle(!showA);
            $('#st2-wo-tab-active').toggleClass('lw-st2-tab--active', showA).attr('aria-selected', showA);
            $('#st2-wo-tab-paused').toggleClass('lw-st2-tab--active', !showA).attr('aria-selected', !showA);
        },
        st2SortState: {},
        st2SortTable: function (tableId, colIdx) {
            var state = _me.st2SortState;
            var key = tableId + '_' + colIdx;
            state[key] = !state[key];
            var asc = state[key];
            var tbody = document.querySelector('#' + tableId + ' tbody');
            if (!tbody) return;
            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                var aText = (a.cells[colIdx] ? a.cells[colIdx].textContent : '').trim();
                var bText = (b.cells[colIdx] ? b.cells[colIdx].textContent : '').trim();
                return asc ? aText.localeCompare(bText, 'zh-Hant') : bText.localeCompare(aText, 'zh-Hant');
            });
            for (var i = 0; i < rows.length; i++) { tbody.appendChild(rows[i]); }
        },
        qqww: function () {
            var arr = new Array();
            $("input:checkbox[id='SI_OPNO']:checked").each(function () {
                arr.push($(this).val()); //向数组中添加元素
            }); //获取界面复选框的所有值
            $("input[name=SI_Slect_OPNOs]").val(arr.join(';'));
        },
        woCloseCheck: function () {
            alert('dddddddddddd');
            var tmp = $("#Select_ID").val();
            var ckINFO = '你確定執行 將工單結束 作業?';
            if (tmp != '') { 
                $.each(tmp.split(';'), function (id,data) {
                    if (data != '') {
                        var ckValue = $("#" + data).val();
                        if (ckValue != '') {
                            alert(ckValue);
                        }
                    }
                });
            }
        },
        changeOrderCMD: function (type) {
            var tmp = $("input[name=OrderBY_CMD]").val();
            var tmparry = tmp.split(',');
            // $('input[type=checkbox][name=optradio]').prop('checked', false);
            // $("input[name=Select_ID]").val('');
            // alert('aaa');
            var tmpint = tmparry[0].indexOf('desc')
            switch (type) {
                case "狀態":
                    if (tmpint < 0) { $("input[name=OrderBY_CMD]").val('order by RemarkTimeS desc,PartNO,IndexSN,OrderNO'); }
                    else { $("input[name=OrderBY_CMD]").val('order by RemarkTimeS,PartNO,IndexSN,OrderNO'); }
                    break;
                case "料件編號":
                    if (tmpint < 0) { $("input[name=OrderBY_CMD]").val('order by PartNO desc,IndexSN,OrderNO,RemarkTimeS desc'); }
                    else { $("input[name=OrderBY_CMD]").val('order by PartNO,IndexSN,OrderNO,RemarkTimeS desc'); }
                    break;
                case "品名":
                    if (tmpint < 0) { $("input[name=OrderBY_CMD]").val('order by PartName desc,PartNO desc,IndexSN,OrderNO,RemarkTimeS desc'); }
                    else { $("input[name=OrderBY_CMD]").val('order by PartName,PartNO,IndexSN,OrderNO,RemarkTimeS desc'); }
                    break;
                case "工序":
                    if (tmpint < 0) { $("input[name=OrderBY_CMD]").val('order by StationNO_Custom_DisplayName desc,IndexSN desc,PartNO desc,OrderNO,RemarkTimeS desc'); }
                    else { $("input[name=OrderBY_CMD]").val('order by StationNO_Custom_DisplayName,IndexSN,PartNO,OrderNO,RemarkTimeS desc'); }
                    break;
                case "工單編號":
                    if (tmpint < 0) { $("input[name=OrderBY_CMD]").val('order by OrderNO desc,PartNO,IndexSN,RemarkTimeS desc'); }
                    else { $("input[name=OrderBY_CMD]").val('order by OrderNO,PartNO,IndexSN,RemarkTimeS desc'); }
                    break;
            }
        },
    };



</script>

<style>
    /* === 全域基底 === */
    .ms-page { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif; color: #1a1d21; }

    /* === 頁面更新按鈕 === */
    #bn_PageReload {
        display: none;
        border: 0;
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
        color: #fff;
        border-radius: 16px;
        height: 280px;
        font-size: 54px;
        font-weight: 700;
        text-shadow: 0 2px 8px rgba(0,0,0,.2);
        box-shadow: 0 8px 32px rgba(238,90,36,.3);
        transition: transform .2s;
    }
    #bn_PageReload:hover { transform: scale(1.02); }

    /* === 通用卡片區塊 === */
    .ms-card {
        border-radius: 12px;
        padding: 1.2rem 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        border: 1px solid rgba(0,0,0,.06);
    }
    .ms-card h2 {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0 0 .75rem;
        display: flex;
        align-items: center;
        gap: .4rem;
    }
    .ms-card h2::before {
        content: "";
        display: inline-block;
        width: 4px;
        height: 1.1em;
        border-radius: 3px;
        flex-shrink: 0;
    }

    /* === 區塊配色 === */
    .ms-card-header { background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); }
    .ms-card-header h2::before { background: #495057; }

    .ms-card-work { background: linear-gradient(135deg, #f0f4ff 0%, #dbe4f8 100%); }
    .ms-card-work h2::before { background: #3b5bdb; }

    .ms-card-report { background: linear-gradient(135deg, #eef2ff 0%, #c8d6f5 100%); }
    .ms-card-report h2::before { background: #4263eb; }

    .ms-card-add { background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); }
    .ms-card-add h2::before { background: #d97706; }

    .ms-card-action { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }
    .ms-card-action h2::before { background: #16a34a; }

    /* === 表格通用 === */
    .ms-main-table { width: 100%; border-collapse: collapse; font-size: .83rem; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.05); border: 1px solid #adb5bd; }
    .ms-main-table thead { background: linear-gradient(180deg, #f1f3f5 0%, #e9ecef 100%); }
    .ms-main-table thead th { padding: .55rem .4rem; font-weight: 600; white-space: nowrap; border: 1px solid #adb5bd; font-size: .8rem; }
    .ms-main-table tbody td { padding: .45rem .4rem; border: 1px solid #ced4da; vertical-align: middle; }
    .ms-main-table tbody tr:hover { background: #f8f9fa; }
    .ms-main-table tbody tr:nth-child(even) { background: #fafbfc; }
    .ms-main-table tbody tr:nth-child(even):hover { background: #f1f3f5; }

    /* === 狀態文字 === */
    .stateRed { color: #dc3545; font-weight: 700; }
    .stateGreen { color: #198754; font-weight: 700; }
    .stateNOT { background: #e9ecef; color: #6c757d; }

    /* === 通用按鈕 === */
    .ms-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .55rem 1.2rem;
        border: none;
        border-radius: 8px;
        font-size: .88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .18s ease;
        text-decoration: none;
    }
    .ms-btn-primary { background: linear-gradient(135deg, #4263eb 0%, #3b5bdb 100%); color: #fff; box-shadow: 0 2px 8px rgba(66,99,235,.25); }
    .ms-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(66,99,235,.35); }
    .ms-btn-success { background: linear-gradient(135deg, #198754 0%, #157347 100%); color: #fff; box-shadow: 0 2px 8px rgba(25,135,84,.25); }
    .ms-btn-success:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(25,135,84,.35); }
    .ms-btn-warning { background: linear-gradient(135deg, #f59f00 0%, #e67700 100%); color: #fff; box-shadow: 0 2px 8px rgba(245,159,0,.25); }
    .ms-btn-warning:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(245,159,0,.35); }
    .ms-btn-danger { background: linear-gradient(135deg, #fa5252 0%, #e03131 100%); color: #fff; box-shadow: 0 2px 8px rgba(250,82,82,.25); }
    .ms-btn-danger:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(250,82,82,.35); }
    .ms-btn-outline { background: #fff; color: #495057; border: 1.5px solid #dee2e6; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .ms-btn-outline:hover { border-color: #adb5bd; background: #f8f9fa; }

    /* === 回到選單連結 === */
    .ms-back-link {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .6rem 1.2rem;
        background: linear-gradient(135deg, #495057 0%, #343a40 100%);
        color: #fff;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: .9rem;
        transition: all .18s;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .ms-back-link:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.2); color: #fff; }
    .ms-back-link::before { content: "\2190"; font-size: 1.1rem; }

    /* === 工站資訊 === */
    .ms-station-info { font-size: .95rem; margin: .5rem 0 0; color: #495057; }
    .ms-station-info strong { color: #1a1d21; font-size: 1rem; }

    /* === 報工區欄位 === */
    .ms-report-field { display: flex; align-items: center; gap: .5rem; margin-bottom: .6rem; flex-wrap: wrap; }
    .ms-report-field label { font-weight: 600; font-size: .88rem; min-width: 5rem; color: #495057; }
    .ms-report-field input[type='number'],
    .ms-report-field input[type='text'] {
        flex: 1;
        min-width: 120px;
        max-width: 240px;
        padding: .4rem .6rem;
        border: 1.5px solid #dee2e6;
        border-radius: 6px;
        font-size: .88rem;
        transition: border-color .18s;
    }
    .ms-report-field input:focus { border-color: #4263eb; outline: none; box-shadow: 0 0 0 3px rgba(66,99,235,.1); }

    /* === 員工選取區 === */
    .ms-staff-grid { display: flex; flex-wrap: wrap; gap: .3rem .6rem; padding: .5rem 0; }
    .ms-staff-grid label { font-size: .85rem; cursor: pointer; display: flex; align-items: center; gap: .2rem; }
    .ms-staff-grid input[type='checkbox'] { accent-color: #4263eb; }

    /* === 操作按鈕列 === */
    .ms-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }

    /* === 新增項目：頁籤 === */
    .lw-st2-wo-title { font-size: 1.05rem; font-weight: 700; margin: 0 0 .5rem; color: #1a1d21; }
    .lw-st2-wo-tabs { display: flex; gap: .4rem; margin: 0 0 0; flex-wrap: wrap; }
    .lw-st2-wo-tab {
        flex: 1 1 42%;
        min-height: 2.65rem;
        padding: .5rem .65rem;
        border: 2px solid #c9a227;
        border-radius: 12px 12px 0 0;
        border-bottom: none;
        background: #fff8e1;
        color: #5c4a00;
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .18s ease, color .18s ease, border-color .18s ease, box-shadow .18s ease;
        text-align: center;
        line-height: 1.25;
        -webkit-tap-highlight-color: transparent;
    }
    .lw-st2-wo-tab:hover { background: #ffecb3; }
    .lw-st2-tab--active.lw-st2-wo-tab-active {
        background: linear-gradient(180deg, #cfe8dc 0%, #8fc9b0 100%);
        border-color: #198754;
        color: #0a3622;
        box-shadow: inset 0 -4px 0 #198754;
    }
    .lw-st2-tab--active.lw-st2-wo-tab-paused {
        background: linear-gradient(180deg, #fff3cd 0%, #f0c14b 100%);
        border-color: #d39e00;
        color: #664d03;
        box-shadow: inset 0 -4px 0 #c7940a;
    }
    .lw-st2-wo-tab:not(.lw-st2-tab--active) { opacity: .9; }
    .lw-st2-wo-badge {
        display: inline-block;
        min-width: 1.3rem;
        padding: .08rem .32rem;
        margin-left: .22rem;
        font-size: .7rem;
        font-weight: 800;
        border-radius: 999px;
        background: rgba(255,255,255,.6);
        vertical-align: middle;
    }
    .lw-st2-wo-panel {
        border: 2px solid #b8860b;
        border-radius: 0 12px 12px 12px;
        padding: .75rem .5rem .85rem;
        background: #fffef7;
        box-shadow: 0 3px 12px rgba(0,0,0,.08);
        margin-bottom: .45rem;
    }
    .lw-st2-wo-panel-active { border-top: 3px solid #198754; }
    .lw-st2-wo-panel-paused { border-top: 3px solid #e0a800; }
    .lw-st2-wo-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 8px; }
    .lw-st2-wo-table-wrap .xg-table { margin-bottom: 0; font-size: .82rem; }
    .lw-st2-wo-table-wrap .xg-table thead th { white-space: nowrap; padding: .45rem .3rem; }
    .lw-st2-wo-table-wrap .xg-table tbody td { padding: .4rem .3rem; vertical-align: middle; }
    .lw-st2-wo-empty {
        display: block;
        padding: .85rem .65rem;
        color: #5c4a00;
        font-size: .88rem;
        background: rgba(255,255,255,.65);
        border-radius: 8px;
        border: 1px dashed #c9a227;
    }

    /* === 排序欄位 === */
    .sortable-th { cursor: pointer; user-select: none; position: relative; padding-right: 18px !important; }
    .sortable-th:hover { background-color: #e2e6ea; }
    .sortable-th::after { content: "\21C5"; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; opacity: 0.5; }

    /* === 錯誤訊息 === */
    .ms-error { background: #fff5f5; border: 1px solid #ffc9c9; border-radius: 8px; padding: .75rem 1rem; color: #c92a2a; font-weight: 600; margin-bottom: .75rem; }

    /* === 分隔線 === */
    .ms-divider { border: none; border-top: 1px solid #e9ecef; margin: 1rem 0; }
</style>

<!--最上層顯示-->
<div class="ms-card ms-card-header">
    <a href="@Url.Action("Read", "STView2Work")" class="ms-back-link">回到工站選單畫面</a>
    @if (err != "")
    {
        <div class="ms-error" style="margin-top:.75rem;">錯誤訊息: <strong>@err</strong></div>
    }
    <p class="ms-station-info">工站編號: <strong>@DATAObj.StationNO</strong>&nbsp;&nbsp;<strong>@DATAObj.StationName</strong></p>
</div>

<!--操作功能區-->
<div class="ms-card ms-card-action">
    <h2>操作功能</h2>
    <div style="display:flex; flex-wrap:wrap; gap:.6rem; align-items:center;">
        <!--開工/停工/結束工單-->
        <form method="post" style="margin:0; display:contents;">
            <input type='hidden' name='Station_Config_Store_Type' value="@DATAObj.Station_Config_Store_Type" />
            <input type='hidden' name='OrderBY_CMD' value="@DATAObj.OrderBY_CMD" />
            <input type='hidden' name='Has_Knives' value="@DATAObj.Has_Knives" />
            <input type='hidden' name='StationNO' value="@DATAObj.StationNO" />
            <input type='hidden' id="Select_ID_Action" name='Select_ID' value="@DATAObj.Select_ID" />
            <button type='submit' class="ms-btn ms-btn-success" data-confirm="你確定執行 開工 作業?" onclick='this.form.action="@Url.Action("SetStation_Open", "STView2Work")"'>&#9654; 開工</button>
            <button type='submit' class="ms-btn ms-btn-warning" data-confirm="你確定執行 停工 作業?" onclick='this.form.action="@Url.Action("SetStation_Stop","STView2Work")"'>&#9724; 停工</button>
            <button type='submit' id="woClosebutton" class="ms-btn ms-btn-danger">&#10006; 結束工單項目</button>
        </form>

        <span style="display:inline-block; width:1px; height:1.8rem; background:#ccc; margin:0 .3rem;"></span>

        <!--領料-->
        <form action=@Url.Action("SetAction") method="post" style="margin:0;">
            <input type='hidden' name='Station_Config_Store_Type' value="@DATAObj.Station_Config_Store_Type" />
            <input type='hidden' name='OrderBY_CMD' value="@DATAObj.OrderBY_CMD" />
            <input type='hidden' name='Has_Knives' value="@DATAObj.Has_Knives" />
            <input type='hidden' name='State' value="領料" />
            <input type='hidden' name='StationNO' value="@DATAObj.StationNO" />
            <input type='hidden' name='StationName' value="@DATAObj.StationName" />
            <input type='hidden' name='SI_OrderNO' value="@DATAObj.SI_OrderNO" />
            <input type='hidden' name='SI_SimulationId' value="@DATAObj.SI_SimulationId" />
            <input type='hidden' name='SI_Slect_OPNOs' value="" />
            <input type='hidden' name='Select_ID' value="@DATAObj.Select_ID" />
            <input type='hidden' name='LocalIPPort' />
            <button type='submit' class="ms-btn ms-btn-primary" onclick="this.style.display='none'">&#128230; 領料</button>
        </form>

        <!--入料-->
        @if (DATAObj.Station_Config_Store_Type == "1")
        {
            <form action=@Url.Action("SetAction") method="post" style="margin:0;">
                <input type='hidden' name='Station_Config_Store_Type' value="@DATAObj.Station_Config_Store_Type" />
                <input type='hidden' name='OrderBY_CMD' value="@DATAObj.OrderBY_CMD" />
                <input type='hidden' name='Has_Knives' value="@DATAObj.Has_Knives" />
                <input type='hidden' name='State' value="入料" />
                <input type='hidden' name='StationNO' value="@DATAObj.StationNO" />
                <input type='hidden' name='StationName' value="@DATAObj.StationName" />
                <input type='hidden' name='SI_OrderNO' value="@DATAObj.SI_OrderNO" />
                <input type='hidden' name='SI_SimulationId' value="@DATAObj.SI_SimulationId" />
                <input type='hidden' name='SI_Slect_OPNOs' value="" />
                <input type='hidden' name='Select_ID' value="@DATAObj.Select_ID" />
                <input type='hidden' name='LocalIPPort' />
                <button type='submit' class="ms-btn ms-btn-primary" onclick="this.style.display='none'">&#128229; 入料</button>
            </form>
        }

        <!--刀具功能-->
        @if (DATAObj.Has_Knives != null && DATAObj.Has_Knives == "1")
        {
            <form action=@Url.Action("SetAction") method="post" style="margin:0;">
                <input type='hidden' name='Station_Config_Store_Type' value="@DATAObj.Station_Config_Store_Type" />
                <input type='hidden' name='OrderBY_CMD' value="@DATAObj.OrderBY_CMD" />
                <input type='hidden' name='Has_Knives' value="@DATAObj.Has_Knives" />
                <input type='hidden' name='StationName' value="@DATAObj.StationName" />
                <input type='hidden' name='State' value="Knives" />
                <input type='hidden' name='StationNO' value="@DATAObj.StationNO" />
                <input type='hidden' name='SI_OrderNO' value="@DATAObj.SI_OrderNO" />

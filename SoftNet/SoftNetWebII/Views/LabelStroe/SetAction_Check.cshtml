@using System.Data
@using Base

@model StoreList

@{
    StoreList _model = ViewBag.StoreList;
}

<script type="text/javascript">
    $(document).ready(function () {
        IS_SYS_Clock = false;
        if (SYS_ClickBlock) { _fun.unBlock(); }
        SYS_ClickBlock = true;
        window.scrollTo(0, 0);
        $('.xg-body').scrollTop(0);

        $('input[type=checkbox][name=optradio_B]').change(function () {
            if ($(this).is(':checked')) {
                var tmp = $("#Select_ID_B").val() + this.value + ";";
                $("#Select_ID_B").val(tmp);
            }
            else {
                var tmp = $("#Select_ID_B").val();
                var tmp02 = this.value + ";";
                $("#Select_ID_B").val(tmp.replace(tmp02, ""));
            }
        });

        var $li = $('ul.tab-title li');
        $($li.eq(0).addClass('active').find('a').attr('href')).siblings('.tab-inner').hide();
        $li.click(function () {
            $($(this).find('a').attr('href')).show().siblings('.tab-inner').hide();
            $(this).addClass('active').siblings('.active').removeClass('active');
        });
    });
    var _me = {
        hasStaionStatus: false,
        hasSimulatioStatus: false,
        STView2Work_PageReload: false,
        hasStaionChangQTY: false,
        qqwwB: function () {
            $("input[name=Select_ID_QTY]").val('');
            var aaa = $("#Select_ID_B").val();
            var bbb = aaa.split(';');
            var eee = "";
            bbb.forEach(function (item) {
                if (item != "") {
                    eee = eee + $("#" + item).val() + ";";
                }
            });
            $("input[name=Select_ID_QTY]").val(eee);
        },
        doSearch: function () {
            _fun.block();
            var form = document.getElementById('searchForm');
            form.submit();
        },
        doReset: function () {
            _fun.block();
            document.getElementById('Search_PartNO').value = '';
            document.getElementById('Search_PartName').value = '';
            document.getElementById('Search_Specification').value = '';
            document.getElementById('Search_Custom01').value = '';
            var form = document.getElementById('searchForm');
            form.submit();
        }
    };
</script>

<p><a href="@Url.Action("StroeFUN", "LabelStroe", new { id = @_model.StoreNO })" class="ui-btn ui-icon-back ui-btn-icon-left">回到功能選單畫面</a></p>
<dir>
    @if (_model != null && _model.ERRMsg != "")
    {
        <p><font color="red" size="6">錯誤訊息:<p><strong>@Html.Raw(_model.ERRMsg)</strong></p></font></p>
    }
</dir>
<div id="tab-demo">
    <ul class="tab-title">
        <li><a href="#tab01">盤點倉庫存貨明細</a></li>
        <li><a href="#tab02">歷史盤營盤損紀錄</a></li>
        <li class="tab-search"><a href="#tab03">條件搜尋相關資料</a></li>
    </ul>

    <div id="tab01" class="tab-inner">
        <form method="post">
            <input type='hidden' name='StoreNO' value="@_model.StoreNO" />
            <input type='hidden' name='StoreSpacesNO' value="@_model.StoreSpacesNO" />
            <input type='hidden' name='Station' value="@_model.Station" />
            <input type='hidden' id="Select_ID_B" name='Select_ID' value="" />
            <input type='hidden' name='Select_ID_QTY' value="" />
            <input type='hidden' name='ActionType' value="A" />
            <p><button type='submit' class="ui-btn ui-icon-grid ui-btn-icon-left" onclick="this.style.display='none'; _me.qqwwB(); _fun.block();">確定異動數量</button></p>
            <p>
                @{
                    if (_model != null && _model.TotalStock_List != null && _model.TotalStock_List.Rows.Count > 0)
                    {
                        <table data-role="table" data-mode="columntoggle" class="ui-responsive ui-shadow data-table" id="DisplayDataTable_B" border="1">
                            <thead>
                                <tr>
                                    <th>選擇</th>
                                    <th>儲位</th>
                                    <th>料件編號/品名/規格</th>
                                    <th>目前存量</th>
                                    <th>單位</th>
                                    <th>實際數量</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    DataRow dataRow = null;
                                    for (int i = 0; i < _model.TotalStock_List.Rows.Count; i++)
                                    {
                                        dataRow = _model.TotalStock_List.Rows[i];
                                        <tr>
                                            <td><input type="checkbox" name="optradio_B" value="@dataRow["Id"].ToString()"></td>
                                            <td>@dataRow["StoreSpacesNO"].ToString()</td>
                                            <td>@dataRow["PartNO"].ToString() @(!dataRow.IsNull("PartName") ? dataRow["PartName"].ToString() : "") @(!dataRow.IsNull("Specification") ? dataRow["Specification"].ToString() : "")</td>
                                            <td>@dataRow["QTY"].ToString()</td>
                                            <td>@(!dataRow.IsNull("MaterialUnit") ? dataRow["MaterialUnit"].ToString() : "")</td>
                                            <td><input type='text' class='form-control' id='@dataRow["Id"].ToString()' value="@dataRow["QTY"].ToString()" /></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <label>目前倉庫無存貨明細資料</label>
                    }
                }
            </p>
        </form>
    </div>

    <div id="tab02" class="tab-inner">
        <form method="post">
            <input type='hidden' name='StoreNO' value="@_model.StoreNO" />
            <input type='hidden' name='StoreSpacesNO' value="@_model.StoreSpacesNO" />
            <input type='hidden' name='Station' value="@_model.Station" />
            <input type='hidden' id="Select_ID_A" name='Select_ID' value="" />
            <input type='hidden' name='Select_ID_QTY' value="" />
            <input type='hidden' name='ActionType' value="B" />
            <p>
                @{
                    if (_model != null && _model.SIDList != null && _model.SIDList.Rows.Count > 0)
                    {
                        <table data-role="table" data-mode="columntoggle" class="ui-responsive ui-shadow data-table" id="DisplayDataTable_A" border="1">
                            <thead>
                                <tr>
                                    <th>儲位</th>
                                    <th>單據編號</th>
                                    <th>料件編號/品名/規格</th>
                                    <th>數量</th>
                                    <th>單位</th>
                                    <th data-priority="2">備註</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    DataRow dataRow2 = null;
                                    for (int i = 0; i < _model.SIDList.Rows.Count; i++)
                                    {
                                        dataRow2 = _model.SIDList.Rows[i];
                                        <tr>
                                            <td>@(dataRow2["OUT_StoreSpacesNO"].ToString() != "" ? dataRow2["OUT_StoreSpacesNO"].ToString() : dataRow2["IN_StoreSpacesNO"].ToString())</td>
                                            <td>@dataRow2["DOCNumberNO"].ToString() @(!dataRow2.IsNull("DOCName") ? dataRow2["DOCName"].ToString() : "")</td>
                                            <td>@dataRow2["PartNO"].ToString() @(!dataRow2.IsNull("PartName") ? dataRow2["PartName"].ToString() : "") @(!dataRow2.IsNull("Specification") ? dataRow2["Specification"].ToString() : "")</td>
                                            <td>@dataRow2["QTY"].ToString()</td>
                                            <td>@dataRow2["Unit"].ToString()</td>
                                            <td>@dataRow2["Remark"].ToString()</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <label>目前沒有計畫性領用明細</label>
                    }
                }
            </p>
        </form>
    </div>

    <div id="tab03" class="tab-inner">
        <form method="post" id="searchForm">
            <input type='hidden' name='StoreNO' value="@_model.StoreNO" />
            <input type='hidden' name='StoreSpacesNO' value="@_model.StoreSpacesNO" />
            <input type='hidden' name='Station' value="@_model.Station" />
            <input type='hidden' name='ActionType' value="" />
            <div class="search-panel">
                <div class="search-row">
                    <label class="search-label">料號：</label>
                    <input type="text" class="search-input" id="Search_PartNO" name="Search_PartNO" value="@_model.Search_PartNO" placeholder="輸入料號關鍵字" />
                </div>
                <div class="search-row">
                    <label class="search-label">品名：</label>
                    <input type="text" class="search-input" id="Search_PartName" name="Search_PartName" value="@_model.Search_PartName" placeholder="輸入品名關鍵字" />
                </div>
                <div class="search-row">
                    <label class="search-label">規格：</label>
                    <input type="text" class="search-input" id="Search_Specification" name="Search_Specification" value="@_model.Search_Specification" placeholder="輸入規格關鍵字" />
                </div>
                <div class="search-row">
                    <label class="search-label">機種：</label>
                    <input type="text" class="search-input" id="Search_Custom01" name="Search_Custom01" value="@_model.Search_Custom01" placeholder="輸入機種關鍵字" />
                </div>
                <div class="search-buttons">
                    <button type="button" class="ui-btn ui-icon-search ui-btn-icon-left btn-search" onclick="_me.doSearch()">依條件搜尋符合的資料</button>
                    <button type="button" class="ui-btn ui-icon-refresh ui-btn-icon-left btn-reset" onclick="_me.doReset()">恢復符合全部的資料</button>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
    #tab-demo {
        width: 100%;
    }

    #tab-demo > ul {
        display: block;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tab-title {
        list-style: none;
    }

    #tab-demo > ul > li {
        display: inline-block;
        vertical-align: top;
        font-family: '微軟正黑體';
        margin: 0 -1px -1px 0;
        border: 1px solid #BCBCBC;
        height: 30px;
        line-height: 30px;
        background: #cdcdcd;
        padding: 0 15px;
        list-style: none;
        box-sizing: border-box;
        cursor: pointer;
    }

    #tab-demo > ul > li a {
        color: #000;
        text-decoration: none;
    }

    #tab-demo > ul > li.active {
        border-bottom: 1px solid #fff;
        background: #fff;
    }

    #tab-demo > ul > li.tab-search a {
        color: #c00;
        font-weight: bold;
    }

    #tab-demo > .tab-inner {
        clear: both;
        color: #000;
        border: 1px #BCBCBC solid;
    }

    .tab-inner {
        padding: 15px;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        background: #f0f0f0;
        padding: 2px 6px;
        text-align: left;
        font-size: 13px;
    }

    .data-table td {
        padding: 1px 6px;
        font-size: 13px;
        line-height: 1.3;
    }

    .data-table input[type='text'] {
        padding: 2px 4px;
        height: 24px;
    }

    .search-panel {
        max-width: 600px;
        padding: 10px 0;
    }

    .search-row {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }

    .search-label {
        width: 60px;
        font-weight: bold;
        text-align: right;
        margin-right: 8px;
    }

    .search-input {
        flex: 1;
        padding: 6px 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 14px;
    }

    .search-buttons {
        margin-top: 15px;
        display: flex;
        gap: 10px;
    }

    .btn-search {
        background-color: #4CAF50 !important;
        color: #fff !important;
    }

    .btn-reset {
        background-color: #2196F3 !important;
        color: #fff !important;
    }
</style>

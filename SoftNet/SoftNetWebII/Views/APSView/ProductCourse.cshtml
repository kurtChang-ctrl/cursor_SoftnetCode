@model APSViewData
@{
    string _isCkeck_SelectFun2_A1 = "";
    string _isCkeck_SelectFun2_A2 = "";
    string _isCkeck_SelectFun2_A3 = "";
    string _isCkeck_SelectFun3_B1 = "";
    string _isCkeck_SelectFun3_B2 = "";
    string _isCkeck_SelectFun3_B3 = "";
    string _isCkeck_SelectFun3_B4 = "";
    string _isCkeck_SelectFun3_B5 = "";
    string _isCkeck_SelectFun3_B6 = "";
}


<script type="text/javascript">
    $(function () {
        IS_SYS_Clock = false;
        if (SYS_ClickBlock) { _fun.unBlock(); }
        SYS_ClickBlock = false;
        $('#divChangQTY').hide();
        $('#divDisplayChangQTYResult').hide();

        // 強制防止左側選單被擠壓
        function fixLeftMenu() {
            var $leftMenu = $('.xg-leftmenu');
            if ($leftMenu.length > 0) {
                $leftMenu.css({
                    'width': '250px !important',
                    'min-width': '250px !important',
                    'max-width': '250px !important',
                    'flex': '0 0 250px !important',
                    'flex-shrink': '0 !important',
                    'flex-grow': '0 !important'
                });
                // 使用 setAttribute 強制設定
                $leftMenu.each(function () {
                    this.style.setProperty('width', '250px', 'important');
                    this.style.setProperty('min-width', '250px', 'important');
                    this.style.setProperty('max-width', '250px', 'important');
                    this.style.setProperty('flex', '0 0 250px', 'important');
                    this.style.setProperty('flex-shrink', '0', 'important');
                    this.style.setProperty('flex-grow', '0', 'important');
                });
            }
        }
        fixLeftMenu();
        // 延遲執行，確保 DOM 完全載入
        setTimeout(fixLeftMenu, 100);
        setTimeout(fixLeftMenu, 500);
        setTimeout(fixLeftMenu, 1000);
        // 監聽 details 展開事件
        $(document).on('click', 'details summary', function () {
            setTimeout(fixLeftMenu, 100);
            setTimeout(fixLeftMenu, 500);
        });
        // 監聽 DOM 變化，確保樣式持續生效
        var observer = new MutationObserver(function () {
            setTimeout(fixLeftMenu, 50);
        });
        if ($('.xg-leftmenu').length > 0) {
            observer.observe(document.querySelector('.xg-leftmenu'), {
                attributes: true,
                attributeFilter: ['style', 'class'],
                childList: true,
                subtree: true
            });
        }
    });
    var _me = {
        hasStaionStatus: false,
        hasSimulatioStatus: true,
        STView2Work_PageReload: false,
        hasStaionChangQTY: false,
        onChangStateShow: function (errType, simulationId, actionType) {
            //switch (errType) {
            //    case "01": return '<div>初建</div>'//改紅燈
            //    case "02": return '<div>模擬中</div>'
            //    case "03": return '<div>完成模擬</div>'
            //}
            var tag = document.getElementById(simulationId);
            if (tag != null && tag !== undefined) {
                tag.className = (actionType == "") ? "labelRed" : "label";
            }
        },
        deleteSimulation: function (id) {
            if (id == '') { return; }
            else {
                var str = _crud.LocalIPPort + ',' + id;
                _ajax.getStr('OnDeleteSimulation', { keys: str }, function (error) {
                    if (!_str.isEmpty(error)) { _tool.msg(error,); }
                    //_crud.pageReload();
                });
            }
        },
        ondeleteConfirm: function () {
            var tmp1 = '';
            var radios = document.getElementsByName('delSIDradio');
            if (radios != null && radios.length > 0) {
                for (var i = 0, length = radios.length; i < length; i++) {
                    if (radios[i].checked) {
                        tmp1 = radios[i].value;
                        break;
                    }
                }
            }
            var Main = {
                Fun_S_List: tmp1,
                NewPartNO: '',
                MBOMId: $("#delNeedId").val(),
                BOMId: '',
                SelectNeedId: '',
                SelectPP_DATA: '',
                SimulationId: $("#sub_SelectPP_DATA").val(),
                ERRMsg: ''
            }
            _ajax.getStr('OnDeleteSimulationII', Main, function (error) {
                if (!_str.isEmpty(error)) { _tool.msg(error,); }
            });
            _tool.onMsgClose();
        },
        changNeedQTY: function (id) {
            if (id == '') { return; }
            var tmp = id.split(',');
            $("input[id=chang_NeedID]").val(tmp[0]);
            $("input[name=chang_NeedQTY]").val(tmp[1]);
            $("input[name=chang_SafeQTY]").val(tmp[2]);
            $('#selectStationPage').hide();
            $('#divDisplayTree').hide();
            $('#divChangQTY').show();
        },
        SetchangNeedQTY: function () {
            var chk = document.getElementById('chang_Is_Simulation');
            var chk_data = (chk && chk.checked) ? '1' : '0';
            var needID = document.getElementById('chang_NeedID');
            var needQTY = document.querySelector('input[name=chang_NeedQTY]');
            var safeQTY = document.querySelector('input[name=chang_SafeQTY]');
            if (!needID || !needQTY || !safeQTY) {
                _tool.msg('找不到必要的輸入欄位');
                return;
            }
            var str = needID.value + ',' + needQTY.value + ',' + safeQTY.value + ',' + chk_data;
            _ajax.getStr('SetchangNeedQTY', { keys: str }, function (data) {

                $('#divChangQTY').hide();
                $('#divDisplayChangQTYResult').show();
                $("#mytext").val(data);
            });
        },
        onShow: function (id) {
            if (id == '') { return; }
            else {
                var str = _crud.LocalIPPort + ',' + id;
                _ajax.getStr('OnAction', { keys: str }, function (error) {
                    if (!_str.isEmpty(error)) { _tool.msg(error,); }
                    //_crud.pageReload();
                });
            }
        },
        SetAction: function (id) {
            var str = _crud.LocalIPPort + ',' + id + ',' + document.getElementById('StationNO01').value + ',' + document.getElementById('StationNO02').value + ',' + document.getElementById('StationNO03').value + ',' + document.getElementById('ageID').value;
            _ajax.getStr('OnActionII', { keys: str }, function (error) {

                if (!_str.isEmpty(error)) { _tool.msg(error); }
                else { _tool.onMsgClose(); }
                //_crud.pageReload();
            });
        },
    }; //class

    $(function () {
        var allOptions = [];
        $('#options1 option').each(function () {
            allOptions.push({
                value: $(this).val(),
                text: $(this).text(),
                partno: $(this).attr('data-partno') || '',
                partname: $(this).attr('data-partname') || ''
            });
        });

        function filterOptions() {
            var kw_partno = $('#txtSearchPartNO').val().trim().toLowerCase();
            var kw_partname = $('#txtSearchPartName').val().trim().toLowerCase();
            var $datalist = $('#options1');
            $datalist.empty();
            allOptions.forEach(function (opt) {
                var matchPartNO = !kw_partno || opt.partno.toLowerCase().indexOf(kw_partno) >= 0;
                var matchPartName = !kw_partname || opt.partname.toLowerCase().indexOf(kw_partname) >= 0;
                if (matchPartNO && matchPartName) {
                    $datalist.append($('<option>', {
                        value: opt.value,
                        text: opt.text,
                        'data-partno': opt.partno,
                        'data-partname': opt.partname,
                        style: 'width:100%;'
                    }));
                }
            });
        }

        $('#btnSearchFilter').on('click', filterOptions);
        $('#txtSearchPartNO, #txtSearchPartName').on('keyup', function (e) {
            if (e.keyCode === 13) filterOptions();
        });
        $('#btnSearchReset').on('click', function () {
            $('#txtSearchPartNO').val('');
            $('#txtSearchPartName').val('');
            var $datalist = $('#options1');
            $datalist.empty();
            allOptions.forEach(function (opt) {
                $datalist.append($('<option>', {
                    value: opt.value,
                    text: opt.text,
                    'data-partno': opt.partno,
                    'data-partname': opt.partname,
                    style: 'width:100%;'
                }));
            });
        });
    });
</script>
@await Component.InvokeAsync("XgProgPath", new { names = new string[] { "生產排程計畫生產歷程查詢" } })
<div id="selectStationPage" class="xp-prog">
    @{
        if (Model.NeedIdList != null && Model.NeedIdList.Count > 0)
        {
            <form action=@Url.Action("ProductCourse") method="post">
                <input type='hidden' name='SelectFun1' value="A" />
                <div class="pc-form-container">
                    <div class="pc-form-body">
                        <div class="pc-form-row pc-search-row">
                            <span class="pc-label">搜尋料號/品名:</span>
                            <input type="text" id="txtSearchPartNO" class="pc-input" style="width:180px;" placeholder="輸入料號">
                            <input type="text" id="txtSearchPartName" class="pc-input" style="width:180px;" placeholder="輸入品名">
                            <button type="button" id="btnSearchFilter" class="pc-btn pc-btn-filter">篩選計畫編號選單</button>
                            <button type="button" id="btnSearchReset" class="pc-btn pc-btn-reset">重置清空篩選</button>
                        </div>
                        <div class="pc-form-row">
                            <span class="pc-label">選擇計畫編號:</span>
                            <input type="text" class="pc-input" style="width:500px;" name='SelectNeedId' list="options1"
                                value="@Model.SelectNeedId">
                            <datalist id="options1">
                                @foreach (string[] s in Model.NeedIdList)
                                {
                                    var s_tmp2 = $"料號:{s[3]} 品名:{s[4]} 規格:{s[5]} 計畫碼:{s[2]}";
                                    var s_tmp = $"{s[2]}";
                                    <option data-partno="@s[3]" data-partname="@s[4]" value='@s_tmp'>@s_tmp2</option>
                                }
                            </datalist>
                        </div>
                        <div class="pc-form-row">
                            @if (Model.SelectFun2 != null && Model.SelectFun2 != "")
                            {
                                if (Model.SelectFun2 == "A1") { _isCkeck_SelectFun2_A1 = "checked"; }
                                else if (Model.SelectFun2 == "A2") { _isCkeck_SelectFun2_A2 = "checked"; }
                                else { _isCkeck_SelectFun2_A3 = "checked"; }
                            }
                            else { _isCkeck_SelectFun2_A3 = "checked"; }
                            <span class="pc-label">料件類型:</span>
                            <label class="pc-radio"><input type="radio" name="SelectFun2" value="A1" @_isCkeck_SelectFun2_A1>半成品</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun2" value="A2" @_isCkeck_SelectFun2_A2>成品</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun2" value="A3" @_isCkeck_SelectFun2_A3>全部</label>
                        </div>
                        <div class="pc-form-row">
                            @if (Model.SelectFun3 != null && Model.SelectFun3 != "")
                            {
                                if (Model.SelectFun3 == "1") { _isCkeck_SelectFun3_B1 = "checked"; }
                                else if (Model.SelectFun3 == "2") { _isCkeck_SelectFun3_B2 = "checked"; }
                                else if (Model.SelectFun3 == "3") { _isCkeck_SelectFun3_B3 = "checked"; }
                                else if (Model.SelectFun3 == "7") { _isCkeck_SelectFun3_B4 = "checked"; }
                                else if (Model.SelectFun3 == "14") { _isCkeck_SelectFun3_B5 = "checked"; }
                                else { _isCkeck_SelectFun3_B6 = "checked"; }
                            }
                            else { _isCkeck_SelectFun3_B1 = "checked"; }
                            <span class="pc-label">操作歷程時間:</span>
                            <label class="pc-radio"><input type="radio" name="SelectFun3" value="1" @_isCkeck_SelectFun3_B1>1日內</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun3" value="2" @_isCkeck_SelectFun3_B2>2日內</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun3" value="3" @_isCkeck_SelectFun3_B3>3日內</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun3" value="7" @_isCkeck_SelectFun3_B4>7日內</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun3" value="14" @_isCkeck_SelectFun3_B5>14日內</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun3" value="30" @_isCkeck_SelectFun3_B6>30日內</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun3" value="180" @_isCkeck_SelectFun3_B6>180日內</label>
                        </div>
                        <div class="pc-form-row">
                            <span class="pc-label">顯示類型:</span>
                            <label class="pc-radio"><input type="radio" name="SelectFun4" value="D1">只針對排程異常警示</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun4" value="D2" checked>只針對數據疑似異常</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun4" value="D3">全部(正常與異常)</label>
                        </div>
                        <div class="pc-form-row">
                            <span class="pc-label">顯示內容:</span>
                            <label class="pc-radio"><input type="radio" name="SelectFun5" value="E1">增加異常明細</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun5" value="E2" checked>增加操作明細</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun5" value="E3">增加報工明細</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun5" value="E4">全部(異常與操作)</label>
                        </div>
                        <div class="pc-form-row">
                            <span class="pc-label">排序方式:</span>
                            <label class="pc-radio"><input type="radio" name="SelectFun6" value="F1">依時間發生順序</label>
                            <label class="pc-radio"><input type="radio" name="SelectFun6" value="F2" checked>依執行碼</label>
                        </div>
                    </div>
                    <div class="pc-form-action">
                        <button type='submit' class="pc-btn pc-btn-submit" onclick="this.style.display='none'">確認查詢</button>
                    </div>
                </div>
            </form>
        }
        else
        {
            <label>無任何計畫編號可選擇</label>
        }
    }

    @{
        if (Model.ERRMsg != "")
        {
            <dir>
                <p>
                    <font color="red" size="5">錯誤訊息:<strong>@Model.ERRMsg</strong></font>
                </p>
            </dir>
        }
    }
</div>
<hr />
@if (ViewBag.HtmlOutput != null && ViewBag.HtmlOutput != "")
{

    <div id="divDisplayTree" class="xp-prog" style="overflow: auto; max-width: 100%;">
        <div id="divSignRows">@Html.Raw(ViewBag.HtmlOutput)</div>
    </div>

}




<style>
    /* 表單容器 */
    .pc-form-container {
        display: flex;
        align-items: stretch;
        gap: 10px;
        border: 1px solid #e0e4e8;
        border-radius: 8px;
        padding: 10px 16px;
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        margin-bottom: 12px;
    }

    .pc-form-body {
        flex: 1;
    }

    .pc-form-action {
        display: flex;
        align-items: center;
        padding-left: 10px;
        border-left: 1px solid #e0e4e8;
        flex: 0 0 auto;
    }

    .pc-form-row {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 2px 0;
        flex-wrap: wrap;
    }

    .pc-search-row {
        padding-bottom: 6px;
        margin-bottom: 4px;
        border-bottom: 1px dashed #d0d5dd;
    }

    .pc-label {
        font-weight: 600;
        font-size: 0.88rem;
        color: #374151;
        white-space: nowrap;
        min-width: 95px;
    }

    .pc-input {
        border: 1px solid #d1d5db;
        border-radius: 5px;
        padding: 5px 10px;
        font-size: 0.88rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }

    .pc-input:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
    }

    .pc-radio {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-size: 0.85rem;
        color: #4b5563;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 4px;
        transition: background 0.15s;
    }

    .pc-radio:hover {
        background: #eff6ff;
    }

    .pc-radio input[type="radio"] {
        accent-color: #3b82f6;
        margin: 0;
    }

    /* 按鈕共用 */
    .pc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 14px;
        font-size: 0.85rem;
        font-weight: 500;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .pc-btn-filter {
        background: #3b82f6;
        color: #fff;
    }

    .pc-btn-filter:hover {
        background: #2563eb;
        box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
    }

    .pc-btn-reset {
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .pc-btn-reset:hover {
        background: #e5e7eb;
    }

    .pc-btn-submit {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        padding: 10px 20px;
        font-size: 0.92rem;
        font-weight: 600;
        border-radius: 6px;
        letter-spacing: 1px;
    }

    .pc-btn-submit:hover {
        background: linear-gradient(135deg, #059669, #047857);
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
        transform: translateY(-1px);
    }

    .pc-btn-submit:active {
        transform: translateY(0);
    }

    /* 異常事件明細表格 */
    .pc-err-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.82rem;
    }

    .pc-err-table thead th {
        background: #f1f5f9;
        padding: 6px 10px;
        text-align: left;
        font-weight: 600;
        color: #374151;
        border-bottom: 2px solid #cbd5e1;
        white-space: nowrap;
    }

    .pc-err-table tbody td {
        padding: 4px 10px;
        border-bottom: 1px solid #e5e7eb;
        color: #4b5563;
        line-height: 1.4;
    }

    .pc-err-table tbody tr:hover {
        background: #f8fafc;
    }

    /* 防止左側選單被擠壓 */
    .xg-leftmenu {
        width: 250px !important;
        min-width: 250px !important;
        max-width: 250px !important;
        flex: 0 0 250px !important;
        flex-shrink: 0 !important;
        flex-grow: 0 !important;
    }

    /* 確保父容器正確處理 flex */
    .d-flex>.xg-leftmenu {
        flex: 0 0 250px !important;
    }

    *,
    *:before,
    *:after {
        -webkit-box-sizing: border-box;
        -moz-box-sizing: border-box;
        box-sizing: border-box;
    }

    input:read-only {
        background-color: #FFB5B5;
    }

    #container1 {
        width: 100%;
        height: 100%;
        display: inline-block;
        margin: 1em;
    }

    #wrapper {
        position: relative;
        overflow: auto;
        max-width: 100%;
        min-height: 100px;
    }

    .shadowbox {
        border: 1px solid #333;
        box-shadow: 8px 8px 5px #444;
        padding: 8px 12px;
        background-image: linear-gradient(180deg, #fff, #ddd 40%, #ccc);
        overflow: visible;
        max-width: 100%;
    }

    /* 確保 fieldset 內容不被截斷 */
    fieldset {
        overflow: visible !important;
        max-height: none !important;
    }

    /* 確保 details 元素內容完整顯示 */
    details {
        overflow: visible !important;
        max-height: none !important;
    }

    details[open] {
        overflow: visible !important;
    }

    /* 確保 details 內的 wrapper 可以完整顯示 */
    details #wrapper {
        overflow: auto !important;
        max-width: 100% !important;
        width: 100% !important;
    }

    /* 使用相對定位布局 */
    .branch {
        position: relative;
        margin-left: 250px;
        margin-top: 30px;
    }

    /* 第一個 branch（頂層）不需要上邊距 */
    .branch.lv1 {
        margin-top: 0;
    }

    /* 每個流程節點容器 */
    .entry {
        position: relative;
        display: inline-block;
        min-height: 80px;
        margin-bottom: 0;
        text-align: center;
        vertical-align: top;
    }


    /* 按鈕樣式 */
    .label {
        display: block;
        min-width: 150px;
        padding: 8px 10px;
        line-height: 1.4;
        text-align: center;
        border: 2px solid #eee9dc;
        border-radius: 5px;
        position: relative;
        margin-right: 2px;
        /* 右邊框緊貼垂直線 */
        white-space: normal;
        word-wrap: break-word;
        box-sizing: border-box;
        z-index: 2;
        margin-bottom: 0;
    }

    .labelRed {
        display: block;
        min-width: 150px;
        padding: 8px 10px;
        line-height: 1.4;
        text-align: center;
        border: 2px solid red;
        border-radius: 5px;
        position: relative;
        margin-right: 2px;
        /* 右邊框緊貼垂直線 */
        white-space: normal;
        word-wrap: break-word;
        box-sizing: border-box;
        z-index: 2;
        margin-bottom: 0;
    }
</style>

@{
    ViewData["Title"] = "AI 生產數據分析";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h2>🤖 AI 生產數據分析</h2>
            <p class="text-muted">分析前 7 天的生產資料，使用 Gemini AI 提供智能分析建議</p>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>分析設定</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="questionInput">分析問題（可選，留空則使用預設分析）：</label>
                        <textarea id="questionInput" class="form-control" rows="3" 
                                  placeholder="例如：分析最近一週的生產效率趨勢，找出效率最高的工站"></textarea>
                    </div>
                    <button id="analyzeBtn" class="btn btn-primary" onclick="analyze()">
                        <i class="fas fa-brain"></i> 開始分析
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3" id="loadingSection" style="display: none;">
        <div class="col-12">
            <div class="alert alert-info text-center">
                <i class="fas fa-spinner fa-spin"></i> 正在分析中，請稍候...
            </div>
        </div>
    </div>

    <div class="row mt-3" id="resultSection" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5><i class="fas fa-chart-line"></i> AI 分析結果</h5>
                </div>
                <div class="card-body">
                    <div id="analysisResult" class="analysis-content"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3" id="dataSection" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="fas fa-database"></i> 生產數據（前 7 天）</h5>
                    <small class="text-muted" id="dataCount"></small>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="dataTable" class="table table-striped table-bordered table-hover">
                            <thead></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3" id="errorSection" style="display: none;">
        <div class="col-12">
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i> <span id="errorMessage"></span>
            </div>
        </div>
    </div>
</div>

<style>
    .analysis-content {
        white-space: pre-wrap;
        word-wrap: break-word;
        line-height: 1.8;
        font-size: 14px;
        padding: 15px;
        background-color: #f8f9fa;
        border-radius: 5px;
        border-left: 4px solid #4285f4;
    }

    #dataTable {
        font-size: 12px;
    }

    #dataTable th {
        background-color: #4285f4;
        color: white;
        font-weight: bold;
    }
</style>

<script>
    /**
     * 執行 AI 分析
     */
    function analyze() {
        var question = $('#questionInput').val().trim();
        var analyzeBtn = $('#analyzeBtn');
        
        // 隱藏之前的結果
        $('#resultSection').hide();
        $('#dataSection').hide();
        $('#errorSection').hide();
        
        // 顯示載入中
        $('#loadingSection').show();
        analyzeBtn.prop('disabled', true);
        
        // 準備資料
        var data = {};
        if (question) {
            data.question = question;
        }
        
        // 呼叫後端 API
        _ajax.getJson('@Url.Action("AnalyzeProduction", "GeminiAI")', data, 
            function(result) {
                $('#loadingSection').hide();
                analyzeBtn.prop('disabled', false);
                
                if (result.success) {
                    // 顯示分析結果
                    displayAnalysisResult(result);
                    
                    // 顯示數據表格
                    if (result.data && result.data.length > 0) {
                        displayDataTable(result.data);
                        $('#dataCount').text('共 ' + result.dataCount + ' 筆資料');
                        $('#dataSection').show();
                    }
                    
                    $('#resultSection').show();
                } else {
                    // 顯示錯誤
                    showError(result.error || '分析失敗');
                }
            },
            function(error) {
                $('#loadingSection').hide();
                analyzeBtn.prop('disabled', false);
                showError('發生錯誤：' + (error.message || error));
            }
        );
    }
    
    /**
     * 顯示分析結果
     */
    function displayAnalysisResult(result) {
        var html = '';
        
        if (result.question) {
            html += '<div class="mb-3"><strong>分析問題：</strong>' + escapeHtml(result.question) + '</div>';
        }
        
        if (result.analysis) {
            html += '<div class="analysis-content">' + escapeHtml(result.analysis) + '</div>';
        }
        
        $('#analysisResult').html(html);
    }
    
    /**
     * 顯示數據表格
     */
    function displayDataTable(data) {
        if (!data || data.length === 0) {
            return;
        }
        
        // 取得所有欄位名稱
        var headers = Object.keys(data[0]);
        
        // 建立表頭
        var thead = '<tr>';
        headers.forEach(function(header) {
            thead += '<th>' + escapeHtml(header) + '</th>';
        });
        thead += '</tr>';
        $('#dataTable thead').html(thead);
        
        // 建立資料列
        var tbody = '';
        data.forEach(function(row) {
            tbody += '<tr>';
            headers.forEach(function(header) {
                var value = row[header] || '';
                tbody += '<td>' + escapeHtml(value) + '</td>';
            });
            tbody += '</tr>';
        });
        $('#dataTable tbody').html(tbody);
    }
    
    /**
     * 顯示錯誤訊息
     */
    function showError(message) {
        $('#errorMessage').text(message);
        $('#errorSection').show();
    }
    
    /**
     * HTML 轉義
     */
    function escapeHtml(text) {
        if (text == null) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>

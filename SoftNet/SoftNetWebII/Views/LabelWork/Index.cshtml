        hasStaionStatus: false,
        hasSimulatioStatus:false,
        STView2Work_PageReload:false,
        hasStaionChangQTY: false,
        is_Sort_Desc:'0',
        radioChange:function(data){
            var tmp = data.split(';');
            $("input[name=OrderNO]").val(tmp[0]);
            $("input[name=IndexSN]").val(tmp[1]);
            $("input[name=SimulationId]").val(tmp[2]);
        },
        woListTab: function (which) {
            var showA = which === 'active';
            $('#wo-panel-active').toggle(showA);
            $('#wo-panel-paused').toggle(!showA);
            $('#wo-tab-btn-active').toggleClass('lw-wo-tab--active', showA).attr('aria-selected', showA);
            $('#wo-tab-btn-paused').toggleClass('lw-wo-tab--active', !showA).attr('aria-selected', !showA);
        },
        sortState: {},
        sortTable: function (tableId, colIdx) {
            var state = _me.sortState;
            var key = tableId + '_' + colIdx;
            state[key] = !state[key];
            var asc = state[key];
            var tbody = document.querySelector('#' + tableId + ' tbody');
            if (!tbody) return;
            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                var aText = (a.cells[colIdx] ? a.cells[colIdx].textContent : '').trim();
                var bText = (b.cells[colIdx] ? b.cells[colIdx].textContent : '').trim();
                return asc ? aText.localeCompare(bText, 'zh-Hant') : bText.localeCompare(aText, 'zh-Hant');
            });
            for (var i = 0; i < rows.length; i++) { tbody.appendChild(rows[i]); }
        },

        clickFunction: function (status) {
            document.getElementById("LocalIPPort").value = _crud.LocalIPPort;
            $('#displayNULL').hide();
            switch (status) {
                case 1://設定工單
                    $('#stationSetOrderNO').show();
                    if ($('#wo-panel-active').length) {
                        var ha = $('#wo-panel-active').find('tbody tr').length > 0;
                        var hp = $('#wo-panel-paused').find('tbody tr').length > 0;
                        if (ha) { _me.woListTab('active'); }
                        else if (hp) { _me.woListTab('paused'); }
                    }
                    break;
                case 2://設定作業人員
                    $('#stationSetOPNO').show();
                    break;
                case 3://報工
                    $('#stationSetINFO').show();
                    break;
                case 4://開始
                    break;
                case 5://停止
                    break;
            }
        },
        testfunction: function (status) {

        },
        // sortCMD: function (id) {
        //     var str = meStationNO + ',' + id + ',';
        //      alert(str);
        //     _ajax.getStr('SET_Sort_CMD', { keys: str }, function (data) {
        //         alert(data);

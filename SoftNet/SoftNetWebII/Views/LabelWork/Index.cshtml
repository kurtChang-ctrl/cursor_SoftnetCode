                    <input type='hidden' name='WO_QTY' value="@Model.WO_QTY" />
                    <input type='hidden' name='TOT_OK_QTY' value="@Model.TOT_OK_QTY" />
                    <input type='hidden' name='TOT_Fail_QTY' value="@Model.TOT_Fail_QTY" />

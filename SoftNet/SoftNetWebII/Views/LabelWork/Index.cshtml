<!--設定工單-->
<div id="stationSetOrderNO">
    <form action=@Url.Action("SetAction") method="post">
        <div class="lw-card lw-card-setwo lw-wo-setorder-box">
            <input type='hidden' name='Has_Knives' value="@Model.Has_Knives" />
            <input type='hidden' name='BOOLonToggleMenu' value="@Model.BOOLonToggleMenu" />
            <input type='hidden' id='State' name='State' value="異動工單" />
            <input type='hidden' id='Station' name='Station' value="@Model.Station" />
            <input type='hidden' name='Station_Name' value="@Model.Station_Name" />
            <input type='hidden' name='StationNO_Custom_DisplayName' value="@Model.StationNO_Custom_DisplayName" />
            <input type='hidden' name='PartNO_INFO' value="@Model.PartNO_INFO" />
            <input type='hidden' name='WO_QTY' value="@Model.WO_QTY" />
            <input type='hidden' name='TOT_OK_QTY' value="@Model.TOT_OK_QTY" />
            <input type='hidden' name='TOT_Fail_QTY' value="@Model.TOT_Fail_QTY" />
            <input type='hidden' name='RemarkTimeS' value="@Model.RemarkTimeS" />
            <input type='hidden' name='RemarkTimeE' value="@Model.RemarkTimeE" />
            <input type='hidden' name='WO_CT' value="@Model.WO_CT" />
            <input type='hidden' name='E_CT' value="@Model.E_CT" />
            <input type='hidden' id='LocalIPPort' name='LocalIPPort' />
            <input type='hidden' id='OPNO' name='OPNO' value="@Model.OPNO" />
            <input type='hidden' id='OPNO_Name' name='OPNO_Name' value="@Model.OPNO_Name" />
            <input type='hidden' id='SimulationId' name='SimulationId' value="@Model.SimulationId" />
            <input type='hidden' id='OrderNO' name='OrderNO' value="@Model.OrderNO" />
            <input type='hidden' id='IndexSN' name='IndexSN' value="@Model.IndexSN" />
            @{
                int woActiveCnt = Model.HasWO_List != null ? Model.HasWO_List.Count : 0;
                int woPausedCnt = Model.HasWO_List_Paused != null ? Model.HasWO_List_Paused.Count : 0;
                if (woActiveCnt > 0 || woPausedCnt > 0)
                {
                    <h2 class="lw-wo-title">選擇工單</h2>
                    <div class="lw-wo-tabs" role="tablist">
                        <button type="button" id="wo-tab-btn-active" class="lw-wo-tab lw-wo-tab-active @(woActiveCnt > 0 ? "lw-wo-tab--active" : "")" role="tab" aria-selected="@(woActiveCnt > 0 ? "true" : "false")" onclick="_me.woListTab('active'); return false;">
                            在線可用工單<span class="lw-wo-badge">@woActiveCnt</span>
                        </button>
                        <button type="button" id="wo-tab-btn-paused" class="lw-wo-tab lw-wo-tab-paused @(woActiveCnt == 0 && woPausedCnt > 0 ? "lw-wo-tab--active" : "")" role="tab" aria-selected="@(woActiveCnt == 0 && woPausedCnt > 0 ? "true" : "false")" onclick="_me.woListTab('paused'); return false;">
                            離線暫停工單<span class="lw-wo-badge">@woPausedCnt</span>
                        </button>
                    </div>
                    <div id="wo-panel-active" class="lw-wo-panel lw-wo-panel-active" style="display:@(woActiveCnt > 0 ? "block" : "none")" role="tabpanel">
                        @if (woActiveCnt > 0)
                        {
                            <div class="lw-wo-table-wrap">
                                <table id="tableReadActive" class='table table-bordered xg-table' cellspacing='0'>
                                    <thead><tr><th>選擇</th><th class="sortable-th" onclick="_me.sortTable('tableReadActive',1)">工單編號</th><th class="sortable-th" onclick="_me.sortTable('tableReadActive',2)">料件編號</th><th class="sortable-th" onclick="_me.sortTable('tableReadActive',3)">品名/規格</th><th>工序</th><th>需求量</th><th>累計OK量</th><th>Fail量</th><th>型態</th><th>名稱</th></tr></thead>
                                    <tbody>
                                        @foreach (string[] s in Model.HasWO_List)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="radio" name="woList" onchange="_me.radioChange('@s[0];@s[12];@s[8]')" />
                                                </td>
                                                <td>@s[0]</td>
                                                <td>@s[1]</td>
                                                <td>@s[2]&nbsp;@s[3]</td>
                                                <td>@s[7]</td>
                                                <td>@s[11]</td>
                                                <td>@s[13]</td>
                                                <td>@s[14]</td>
                                                <td>@s[4]</td>
                                                <td>@s[5]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <span class="lw-wo-empty">此分頁無可用工單（進行中需求且工單未暫停）。</span>
                        }
                    </div>
                    <div id="wo-panel-paused" class="lw-wo-panel lw-wo-panel-paused" style="display:@(woActiveCnt > 0 ? "none" : "block")" role="tabpanel">
                        @if (woPausedCnt > 0)
                        {
                            <div class="lw-wo-table-wrap">
                                <table id="tableReadPaused" class='table table-bordered xg-table' cellspacing='0'>
                                    <thead><tr><th>選擇</th><th class="sortable-th" onclick="_me.sortTable('tableReadPaused',1)">工單編號</th><th class="sortable-th" onclick="_me.sortTable('tableReadPaused',2)">料件編號</th><th class="sortable-th" onclick="_me.sortTable('tableReadPaused',3)">品名/規格</th><th>工序</th><th>需求量</th><th>累計OK量</th><th>Fail量</th><th>型態</th><th>名稱</th></tr></thead>
                                    <tbody>
                                        @foreach (string[] s in Model.HasWO_List_Paused)
                                        {
                                            <tr>
                                                <td>
                                                    <input type="radio" name="woList" onchange="_me.radioChange('@s[0];@s[12];@s[8]')" />
                                                </td>
                                                <td>@s[0]</td>
                                                <td>@s[1]</td>
                                                <td>@s[2]&nbsp;@s[3]</td>
                                                <td>@s[7]</td>
                                                <td>@s[11]</td>
                                                <td>@s[13]</td>
                                                <td>@s[14]</td>
                                                <td>@s[4]</td>
                                                <td>@s[5]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <span class="lw-wo-empty">此分頁無暫停需求工單。</span>
                        }
                    </div>
                    <div class="lw-wo-submit-row lw-actions"><button type='submit' class="lw-btn lw-btn-warning" onclick="this.style.display='none'">&#10004; 異動確定</button></div>
                }
                else
                {
                    <span class="lw-wo-empty">目前本站無其他生產計劃需求工單</span>
                }
            }
            
        </div>
    </form>
    @{
        if (Model.State != "領料" || Model.State != "入料")
        {
            string arg5 = Model.BOOLonToggleMenu;
            if (arg5 != "") { arg5 = $";{arg5}"; }
            if (Model.SimulationId != "")
            {
                <p><a href="@Url.Action("Index", "LabelWork",$"{Model.Station};2;{Model.SimulationId};{Model.IndexSN}{arg5}")" class="lw-btn-back">回到主選單畫面</a></p>
            }
            else if (Model.OrderNO != "")
            {
                                <p><a href="@Url.Action("Index", "LabelWork",$"{Model.Station};1;{Model.OrderNO};{Model.IndexSN}{arg5}")" class="lw-btn-back">回到主選單畫面</a></p>
            }
            else
            {
                                <p><a href="@Url.Action("Index", "LabelWork",$"{Model.Station};0;;0{arg5}")" class="lw-btn-back">回到主選單畫面</a></p>
            }
        }
    }
</div>


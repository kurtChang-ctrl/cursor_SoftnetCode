<style>
    /* === LabelWork 全域基底 === */
    .lw-page { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans TC", sans-serif; }

    /* === 卡片區塊 === */
    .lw-card {
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: .85rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        border: 1px solid rgba(0,0,0,.06);
    }
    .lw-card h2, .lw-card h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0 0 .6rem;
        display: flex;
        align-items: center;
        gap: .4rem;
    }
    .lw-card h2::before, .lw-card h3::before {
        content: "";
        display: inline-block;
        width: 4px;
        height: 1em;
        border-radius: 3px;
        flex-shrink: 0;
    }

    /* === 區塊配色 === */
    .lw-card-info { background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); }
    .lw-card-info h2::before { background: #495057; }
    .lw-card-action { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); }
    .lw-card-action h2::before { background: #16a34a; }
    .lw-card-report { background: linear-gradient(135deg, #eef2ff 0%, #c8d6f5 100%); }
    .lw-card-report h2::before, .lw-card-report h3::before { background: #4263eb; }
    .lw-card-setwo { background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); }
    .lw-card-setwo h2::before { background: #d97706; }
    .lw-card-staff { background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 100%); }
    .lw-card-staff h2::before { background: #db2777; }

    /* === 工站資訊表格 === */
    .lw-info-grid { display: grid; grid-template-columns: auto 1fr; gap: .25rem .6rem; font-size: .9rem; }
    .lw-info-grid dt { font-weight: 600; color: #495057; white-space: nowrap; }
    .lw-info-grid dd { margin: 0; color: #1a1d21; font-weight: 500; }
    .lw-status-badge {
        display: inline-block;
        padding: .15rem .5rem;
        border-radius: 6px;
        font-size: .82rem;
        font-weight: 700;
        color: #fff;
    }
    .lw-status-running { background: linear-gradient(135deg, #198754, #157347); }
    .lw-status-stopped { background: linear-gradient(135deg, #dc3545, #b02a37); }
    .lw-status-idle { background: #6c757d; }

    /* === 通用按鈕 === */
    .lw-btn {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .5rem 1rem;
        border: none;
        border-radius: 8px;
        font-size: .88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .18s ease;
        text-decoration: none;
    }
    .lw-btn-primary { background: linear-gradient(135deg, #4263eb 0%, #3b5bdb 100%); color: #fff; box-shadow: 0 2px 8px rgba(66,99,235,.25); }
    .lw-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(66,99,235,.35); }
    .lw-btn-success { background: linear-gradient(135deg, #198754 0%, #157347 100%); color: #fff; box-shadow: 0 2px 8px rgba(25,135,84,.25); }
    .lw-btn-success:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(25,135,84,.35); }
    .lw-btn-warning { background: linear-gradient(135deg, #f59f00 0%, #e67700 100%); color: #fff; box-shadow: 0 2px 8px rgba(245,159,0,.25); }
    .lw-btn-warning:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(245,159,0,.35); }
    .lw-btn-danger { background: linear-gradient(135deg, #fa5252 0%, #e03131 100%); color: #fff; box-shadow: 0 2px 8px rgba(250,82,82,.25); }
    .lw-btn-danger:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(250,82,82,.35); }
    .lw-btn-outline { background: #fff; color: #495057; border: 1.5px solid #dee2e6; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .lw-btn-outline:hover { border-color: #adb5bd; background: #f8f9fa; }
    .lw-btn-back {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .5rem 1rem;
        background: linear-gradient(135deg, #495057 0%, #343a40 100%);
        color: #fff;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: .88rem;
        transition: all .18s;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .lw-btn-back:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.2); color: #fff; }
    .lw-btn-back::before { content: "\2190"; font-size: 1.1rem; }

    /* === 按鈕群組 === */
    .lw-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }

    /* === 報工欄位 === */
    .lw-field { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; flex-wrap: wrap; }
    .lw-field label { font-weight: 600; font-size: .88rem; min-width: 5rem; color: #495057; }
    .lw-field input[type='number'],
    .lw-field input[type='text'] {
        flex: 1;
        min-width: 100px;
        max-width: 220px;
        padding: .4rem .6rem;
        border: 1.5px solid #dee2e6;
        border-radius: 6px;
        font-size: .88rem;
        transition: border-color .18s;
    }
    .lw-field input:focus { border-color: #4263eb; outline: none; box-shadow: 0 0 0 3px rgba(66,99,235,.1); }

    /* === 錯誤訊息 === */
    .lw-error { background: #fff5f5; border: 1px solid #ffc9c9; border-radius: 8px; padding: .6rem .85rem; color: #c92a2a; font-weight: 600; margin-bottom: .6rem; }

    /* === 設定工單頁籤 === */
    .lw-wo-setorder-box { padding-bottom: .25rem; }
    .lw-wo-title { font-size: 1.05rem; font-weight: 700; color: #1a1d21; margin: 0 0 .65rem; }
    .lw-wo-tabs { display: flex; gap: .4rem; margin: 0; flex-wrap: wrap; }
    .lw-wo-tab {
        flex: 1 1 42%;
        min-height: 2.75rem;
        padding: .55rem .75rem;
        border: 2px solid #ced4da;
        border-radius: 12px 12px 0 0;
        border-bottom: none;
        background: #e9ecef;
        color: #495057;
        font-size: .9rem;
        font-weight: 700;
        cursor: pointer;
        transition: background .18s ease, color .18s ease, border-color .18s ease, box-shadow .18s ease;
        text-align: center;
        line-height: 1.25;
        -webkit-tap-highlight-color: transparent;
    }
    .lw-wo-tab:hover { background: #dee2e6; }
    .lw-wo-tab--active.lw-wo-tab-active {
        background: linear-gradient(180deg, #cfe8dc 0%, #8fc9b0 100%);
        border-color: #198754;
        color: #0a3622;
        box-shadow: inset 0 -4px 0 #198754;
    }
    .lw-wo-tab--active.lw-wo-tab-paused {
        background: linear-gradient(180deg, #fff3cd 0%, #f0c14b 100%);
        border-color: #d39e00;
        color: #664d03;
        box-shadow: inset 0 -4px 0 #c7940a;
    }
    .lw-wo-tab:not(.lw-wo-tab--active) { opacity: .88; }
    .lw-wo-badge {
        display: inline-block;
        min-width: 1.35rem;
        padding: .1rem .35rem;
        margin-left: .25rem;
        font-size: .72rem;
        font-weight: 800;
        border-radius: 999px;
        vertical-align: middle;
        background: rgba(255,255,255,.55);
    }
    .lw-wo-panel {
        border: 2px solid #dee2e6;
        border-radius: 0 12px 12px 12px;
        padding: .85rem .75rem 1rem;
        background: #fff;
        box-shadow: 0 3px 14px rgba(0,0,0,.07);
        margin-bottom: .5rem;
    }
    .lw-wo-panel-active { border-top: 3px solid #198754; }
    .lw-wo-panel-paused { border-top: 3px solid #e0a800; }
    .lw-wo-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 8px; }
    .lw-wo-table-wrap .xg-table { margin-bottom: 0; font-size: .85rem; }
    .lw-wo-table-wrap .xg-table thead th { white-space: nowrap; padding: .5rem .4rem; background: linear-gradient(180deg, #f1f3f5, #e9ecef); font-weight: 600; }
    .lw-wo-table-wrap .xg-table tbody td { padding: .45rem .4rem; vertical-align: middle; }
    .lw-wo-table-wrap .xg-table tbody tr:hover { background: #f8f9fa; }
    .lw-wo-empty {
        display: block;
        padding: 1rem .75rem;
        color: #6c757d;
        font-size: .9rem;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px dashed #ced4da;
    }
    .lw-wo-submit-row { margin-top: .85rem; margin-bottom: 0; }

    /* === 排序欄位 === */
    .sortable-th { cursor: pointer; user-select: none; position: relative; padding-right: 18px !important; }
    .sortable-th:hover { background-color: #e2e6ea; }
    .sortable-th::after { content: "\21C5"; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; opacity: 0.5; }
</style>

<div id="displayNULL" data-role="page">
    <div class="lw-card lw-card-info">
        <h2>工站資訊</h2>
        <dl class="lw-info-grid">
            <dt>工站編號</dt><dd>@Model.Station &nbsp; @Model.Station_Name</dd>
            <dt>狀態</dt>
            <dd>
                @{
                    if (Model.Station_State != null && Model.Station_State == "生產中...")
                    {
                        <span class="lw-status-badge lw-status-running">@Model.Station_State</span>
                    }
                    else if (Model.Station_State != null && Model.Station_State == "停止...")
                    {
                        <span class="lw-status-badge lw-status-stopped">@Model.Station_State</span>
                    }
                    else
                    {
                        <span class="lw-status-badge lw-status-idle">@Model.Station_State</span>
                    }
                }
            </dd>
            <dt>工單編號</dt><dd>@Model.OrderNO</dd>
            <dt>工序名稱</dt><dd>@Model.StationNO_Custom_DisplayName</dd>
            <dt>生產料件</dt><dd>@Model.PartNO_INFO</dd>
            <dt>前站完成量</dt><dd>@Model.Transfer_QTY</dd>
            <dt>工單數量</dt><dd>@Model.WO_QTY</dd>
            <dt>累計OK量</dt><dd>@Model.TOT_OK_QTY</dd>
            <dt>Fail量</dt><dd>@Model.TOT_Fail_QTY</dd>
            <dt>開始日</dt><dd>@Model.RemarkTimeS</dd>
            <dt>停止日</dt><dd>@Model.RemarkTimeE</dd>
            <dt>實際CT</dt><dd>@Model.WO_CT</dd>
